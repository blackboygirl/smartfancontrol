#!/bin/bash

NAME="smartfancontrol"
PLUGIN_DIR="/usr/local/emhttp/plugins/$NAME"
DAEMON="$PLUGIN_DIR/scripts/smartfan-daemon.php"
CONFIG="/boot/config/plugins/$NAME/config.json"
RUN_DIR="/run/$NAME"
PID_FILE="$RUN_DIR/$NAME.pid"
LOG="/var/log/$NAME.log"

is_running() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    if [[ -n "$pid" && -d "/proc/$pid" ]]; then
      return 0
    fi
  fi
  return 1
}

start_service() {
  mkdir -p "$RUN_DIR" /boot/config/plugins/$NAME
  if is_running; then
    echo "$NAME already running"
    return 0
  fi

  # Recover from a previous crash before taking control again.
  if [[ -x "$DAEMON" ]]; then
    "$DAEMON" --restore >/dev/null 2>&1 || true
  fi

  local enabled="false"
  if [[ -f "$CONFIG" ]]; then
    enabled="$(php -r '$d=@json_decode(@file_get_contents($argv[1]),true); echo !empty($d["enabled"])?"true":"false";' "$CONFIG" 2>/dev/null)"
  fi
  if [[ "$enabled" != "true" ]]; then
    echo "$NAME configured but globally disabled"
    return 0
  fi

  nohup "$DAEMON" --daemon >>"$LOG" 2>&1 &
  local pid=$!
  sleep 0.3
  if [[ -d "/proc/$pid" ]]; then
    echo "$pid" > "$PID_FILE"
    echo "$NAME started (pid $pid)"
    return 0
  fi
  echo "failed to start $NAME"
  return 1
}

stop_service() {
  if is_running; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    kill "$pid" 2>/dev/null || true
    for _ in {1..30}; do
      [[ ! -d "/proc/$pid" ]] && break
      sleep 0.1
    done
    if [[ -d "/proc/$pid" ]]; then
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$PID_FILE"
  if [[ -x "$DAEMON" ]]; then
    "$DAEMON" --restore >/dev/null 2>&1 || true
  fi
  echo "$NAME stopped"
}

status_service() {
  if is_running; then
    echo "running (pid $(cat "$PID_FILE"))"
    return 0
  fi
  echo "stopped"
  return 1
}

case "${1:-status}" in
  start) start_service ;;
  stop) stop_service ;;
  restart) stop_service; start_service ;;
  status) status_service ;;
  restore) "$DAEMON" --restore ;;
  *) echo "Usage: $0 {start|stop|restart|status|restore}"; exit 2 ;;
esac

