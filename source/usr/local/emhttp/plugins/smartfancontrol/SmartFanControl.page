<script>
(function(){
'use strict';
const root=document.getElementById('sfc-root');
if(root.dataset.init==='1') return; root.dataset.init='1';
const csrf=<?=json_encode((string)$csrf)?>;
const api='/plugins/smartfancontrol/api.php';
let hw={pwms:[],fans:[],temps:[],gpus:[]};
let cfg={version:1,enabled:false,interval:5,profiles:[]};
let lastStatus={};
let driverInfo={modules:[],status:[],detect_available:false,sensors_detect:'',perl:''};
let fanDisplay={config:{version:1,hide_zero_rpm:true,remarks:{}},fans:[]};
let pollTimer=null;

const $=s=>root.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid=()=> 'fan_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,7);
function msg(text,ok=true){const el=$('#sfc-message');el.className='sfc-message '+(ok?'ok':'err');el.textContent=text;clearTimeout(el._t);el._t=setTimeout(()=>{el.className='sfc-message';},6000)}
function post(action,extra={}){const fd=new URLSearchParams();fd.set('action',action);fd.set('csrf_token',csrf);Object.entries(extra).forEach(([k,v])=>fd.set(k,v));return fetch(api,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:fd.toString(),cache:'no-store'}).then(async r=>{const d=await r.json().catch(()=>({ok:false,error:'Invalid API response'}));if(!r.ok||d.ok===false)throw new Error(d.error||('HTTP '+r.status));return d;});}
function selectorId(o,kind){if(!o)return'';return 'hwmon|'+(o.chip||'')+'|'+(o.device||'')+'|'+(o.channel||'');}
function sensorId(s){if(!s)return'';if(s.type==='nvidia')return'nvidia|'+s.uuid;if(s.type==='array_max')return'array|max';if(s.type==='hwmon')return'hwtemp|'+(s.chip||'')+'|'+(s.device||'')+'|'+(s.input||'');return'';}
function allSensors(){return [...(hw.gpus||[]),...(hw.temps||[])];}
function findPwm(id){return (hw.pwms||[]).find(x=>x.id===id)}
function findFan(id){return (hw.fans||[]).find(x=>x.id===id)}
function findSensor(id){return allSensors().find(x=>x.id===id)}
function defaultProfile(){return {id:uid(),name:'新风扇控制器',enabled:true,pwm:null,rpm:null,sensor_mode:'max',sensors:[],curve:[{temp:45,pwm:40},{temp:55,pwm:50},{temp:65,pwm:70},{temp:75,pwm:100}],critical_temp:80,failsafe_pwm:100,min_pwm:30,min_rpm:0,rpm_guard_pwm:35};}
function optionHtml(items,selected,placeholder){let out='<option value="">'+esc(placeholder)+'</option>';items.forEach(x=>{out+='<option value="'+esc(x.id)+'" '+(x.id===selected?'selected':'')+'>'+esc(x.label)+(x.rpm!=null?' — '+x.rpm+' RPM':'')+'</option>'});if(selected&&!items.some(x=>x.id===selected))out+='<option selected value="'+esc(selected)+'">已保存（当前未检测到）</option>';return out;}
function sensorRows(profile){const selected=new Set((profile.sensors||[]).map(sensorId));const catalog=allSensors().slice();(profile.sensors||[]).forEach(s=>{const id=sensorId(s);if(id&&!catalog.some(x=>x.id===id))catalog.push({...s,id,label:(s.label||id)+'（当前不可用）',temp:null});});if(!catalog.length)return'<div style="padding:8px;color:#777">未检测到可用温度传感器</div>';return catalog.map(s=>'<label class="sfc-sensor-row"><input type="checkbox" class="sensor-check" value="'+esc(s.id)+'" '+(selected.has(s.id)?'checked':'')+'><span>'+esc(s.label)+'</span><span class="sfc-sensor-temp">'+(s.temp==null?'--':esc(s.temp)+' °C')+'</span></label>').join('');}
function curveRows(curve){return (curve||[]).map((pt,i)=>'<tr><td><input class="curve-temp" type="number" step="1" value="'+esc(pt.temp)+'"></td><td><input class="curve-pwm" type="number" min="0" max="100" step="1" value="'+esc(pt.pwm)+'"></td><td><button type="button" class="sfc-mini-btn curve-del" data-i="'+i+'">删除</button></td></tr>').join('');}
function renderDriverInfo(info,writeEditor=false){
  driverInfo=info||driverInfo||{};
  const editor=$('#sfc-drivers');
  if(writeEditor&&editor)editor.value=(driverInfo.modules||[]).join('\n');
  const cap=$('#sfc-driver-capability');
  if(cap){
    if(driverInfo.detect_available)cap.innerHTML='<span class="sfc-driver-ok">✓ sensors-detect 可用</span>';
    else if(!driverInfo.sensors_detect)cap.innerHTML='<span class="sfc-driver-warn">sensors-detect 不可用</span>';
    else cap.innerHTML='<span class="sfc-driver-warn">缺少 Perl，无法自动检测</span>';
  }
  const st=$('#sfc-driver-status');
  if(st){
    const rows=(driverInfo.status||[]).map(x=>'<span class="sfc-driver-row '+(x.loaded?'sfc-driver-ok':'sfc-driver-warn')+'">'+esc(x.name)+'：'+(x.loaded?'已加载':(x.available?'可加载':'不可用'))+'</span>');
    st.innerHTML=rows.length?rows.join(''):'尚未保存传感器驱动。可以点击“自动检测驱动”。';
  }
  const detect=$('#sfc-driver-detect');if(detect)detect.disabled=!driverInfo.detect_available;
}
async function refreshDrivers(writeEditor=true){try{const d=await post('driver_info');renderDriverInfo(d.drivers||{},writeEditor);}catch(e){msg('读取驱动状态失败：'+e.message,false)}}
async function detectDrivers(){const btn=$('#sfc-driver-detect');try{btn.disabled=true;btn.value='正在检测…';const d=await post('driver_detect');const mods=(d.detected?.modules||[]),sd=(d.detected?.sensors_detect_modules||[]),fb=(d.detected?.loaded_hwmon_modules||[]);$('#sfc-drivers').value=mods.join('\n');renderDriverInfo(d.drivers||{},false);let via=sd.length?'sensors-detect':'';if(fb.length)via+=(via?' + ':'')+'当前已加载 hwmon';msg('检测完成：'+mods.join(', ')+(via?'（'+via+'）':'')+'。确认后点击“保存并加载驱动”。');}catch(e){msg('驱动检测失败：'+e.message,false)}finally{btn.value='自动检测驱动';btn.disabled=!driverInfo.detect_available}}
async function saveDrivers(){try{const text=$('#sfc-drivers').value;const d=await post('driver_save',{modules:text});driverInfo=d.drivers||driverInfo;if(d.hardware)hw=d.hardware;renderDriverInfo(driverInfo,true);render();await refreshFanDisplay(true);msg('驱动已保存并加载，硬件已重新扫描。');}catch(e){msg('保存驱动失败：'+e.message,false)}}
function renderFanDisplay(info,writeEditor=true){
  fanDisplay=info||fanDisplay||{config:{hide_zero_rpm:true,remarks:{}},fans:[]};
  const cfgd=fanDisplay.config||{};
  const hide=$('#sfc-hide-zero-rpm');if(hide)hide.checked=cfgd.hide_zero_rpm!==false;
  const host=$('#sfc-fan-display-list');if(!host)return;
  const fans=fanDisplay.fans||[];
  if(!fans.length){host.innerHTML='<div class="sfc-empty" style="margin-top:10px;padding:16px">当前未检测到 RPM 风扇传感器。</div>';return;}
  host.innerHTML='<table class="sfc-fan-table"><thead><tr><th>仪表板通道</th><th>硬件来源</th><th>当前转速</th><th>备注 / 显示名称</th></tr></thead><tbody>'+fans.map(f=>{
    const key=String(f.key||'');const rpm=f.rpm==null?null:Number(f.rpm);const remark=(cfgd.remarks||{})[key]??f.remark??'';
    return '<tr class="'+(rpm===0?'sfc-fan-zero':'')+'"><td><b>'+esc(key.toUpperCase().replace('FAN','FAN '))+'</b></td><td class="sfc-fan-source">'+esc((f.chip||'')+' - '+(f.channel||''))+'</td><td class="sfc-fan-rpm">'+(rpm==null?'--':esc(rpm)+' RPM')+'</td><td><input type="text" class="sfc-fan-remark" data-key="'+esc(key)+'" maxlength="80" value="'+esc(remark)+'" placeholder="例如：CPU 风扇 / P4 排风"></td></tr>';
  }).join('')+'</tbody></table>';
}
async function refreshFanDisplay(writeEditor=true){try{const d=await post('fan_display_info');renderFanDisplay(d.fan_display||fanDisplay,writeEditor);}catch(e){msg('读取风扇显示设置失败：'+e.message,false)}}
async function saveFanDisplay(){try{const remarks={};root.querySelectorAll('.sfc-fan-remark').forEach(el=>{const key=el.dataset.key||'';const value=el.value.trim();if(key&&value)remarks[key]=value;});const payload={hide_zero_rpm:$('#sfc-hide-zero-rpm').checked,remarks};const d=await post('fan_display_save',{payload:JSON.stringify(payload)});renderFanDisplay(d.fan_display||fanDisplay,true);msg('风扇显示设置已保存；仪表板会自动应用，已打开的仪表板最多等待几秒即可刷新。');}catch(e){msg('保存风扇显示设置失败：'+e.message,false)}}
function profileStatus(id){return (lastStatus.profiles||{})[id]||{};}
function render(){
  $('#sfc-global-enabled').checked=!!cfg.enabled;$('#sfc-interval').value=cfg.interval||5;
  const cards=$('#sfc-cards');
  if(!cfg.profiles.length){cards.innerHTML='<div class="sfc-empty">还没有控制器。点击“+ 添加控制器”，例如创建 <b>Tesla P4 → nct6793 pwm5</b>。</div>';return;}
  cards.innerHTML=cfg.profiles.map((p,idx)=>{const st=profileStatus(p.id);const pwmSel=selectorId(p.pwm,'pwm'),rpmSel=selectorId(p.rpm,'fan');return `
  <section class="sfc-card" data-id="${esc(p.id)}">
    <div class="sfc-card-head">
      <label><input type="checkbox" class="profile-enabled" ${p.enabled?'checked':''}> 启用</label>
      <input type="text" class="profile-name" value="${esc(p.name)}" aria-label="控制器名称">
      <button type="button" class="profile-remove sfc-danger">删除控制器</button>
    </div>
    <div class="sfc-live">
      <div>温度<b class="live-temp">${st.temperature==null?'--':esc(st.temperature)+' °C'}</b></div>
      <div>PWM<b class="live-pwm">${st.applied_pwm==null?'--':esc(st.applied_pwm)+'%'}</b></div>
      <div>转速<b class="live-rpm">${st.rpm==null?'--':esc(st.rpm)+' RPM'}</b></div>
      <div>状态<b class="live-state">${esc(st.reason||st.state||'--')}</b></div>
    </div>
    <div class="sfc-grid">
      <div class="sfc-field"><label>PWM 控制器</label><select class="pwm-select">${optionHtml(hw.pwms||[],pwmSel,'请选择 PWM')}</select><small>保存芯片名+设备路径+通道，不依赖 hwmonX 编号。</small></div>
      <div class="sfc-field"><label>RPM 传感器</label><select class="rpm-select">${optionHtml(hw.fans||[],rpmSel,'可不选择')}</select><small>用于转速显示和停转保护。</small></div>
      <div class="sfc-field" style="grid-column:1/-1"><label>温度传感器（可多选）</label><div class="sfc-sensors">${sensorRows(p)}</div></div>
      <div class="sfc-field"><label>多传感器计算</label><select class="sensor-mode"><option value="max" ${p.sensor_mode!=='avg'?'selected':''}>取最高温度</option><option value="avg" ${p.sensor_mode==='avg'?'selected':''}>取平均温度</option></select></div>
      <div class="sfc-field"><label>最低 PWM (%)</label><input class="min-pwm" type="number" min="0" max="100" value="${esc(p.min_pwm??30)}"><small>曲线要求非零转速时不会低于此值。</small></div>
      <div class="sfc-field" style="grid-column:1/-1"><label>风扇曲线</label><table class="sfc-curve"><thead><tr><th>温度 °C</th><th>PWM %</th><th></th></tr></thead><tbody>${curveRows(p.curve)}</tbody></table><div class="sfc-curve-actions"><button type="button" class="curve-add sfc-mini-btn">+ 曲线节点</button></div></div>
      <div class="sfc-field"><label>临界温度 °C</label><input class="critical-temp" type="number" min="20" max="150" value="${esc(p.critical_temp??80)}"><small>达到后强制 100% PWM。</small></div>
      <div class="sfc-field"><label>传感器失联 Fail-safe (%)</label><input class="failsafe-pwm" type="number" min="20" max="100" value="${esc(p.failsafe_pwm??100)}"><small>建议保持 100%。</small></div>
      <div class="sfc-field"><label>最低安全 RPM</label><input class="min-rpm" type="number" min="0" max="30000" value="${esc(p.min_rpm??0)}"><small>0=关闭停转保护；建议确认风扇最低稳定转速后填写。</small></div>
      <div class="sfc-field"><label>RPM 检测起始 PWM (%)</label><input class="rpm-guard-pwm" type="number" min="0" max="100" value="${esc(p.rpm_guard_pwm??35)}"><small>高于此 PWM 且连续 3 次低于最低 RPM，会强制 100%。</small></div>
    </div>
  </section>`}).join('');
  bindCards();
}
function bindCards(){root.querySelectorAll('.sfc-card').forEach(card=>{
  card.querySelector('.profile-remove').addEventListener('click',()=>{const id=card.dataset.id;if(confirm('删除这个控制器？删除并保存后会恢复该 PWM 原来的控制模式。')){syncFromDom();cfg.profiles=cfg.profiles.filter(x=>x.id!==id);render();}});
  card.querySelector('.curve-add').addEventListener('click',()=>{syncFromDom();const p=cfg.profiles.find(x=>x.id===card.dataset.id);p.curve.push({temp:(p.curve.at(-1)?.temp??60)+5,pwm:Math.min(100,(p.curve.at(-1)?.pwm??70)+10)});render();});
  card.querySelectorAll('.curve-del').forEach(btn=>btn.addEventListener('click',()=>{syncFromDom();const p=cfg.profiles.find(x=>x.id===card.dataset.id);if(p.curve.length<=2){msg('至少保留 2 个曲线节点。',false);return;}p.curve.splice(Number(btn.dataset.i),1);render();}));
 });}
function syncFromDom(){
  cfg.enabled=$('#sfc-global-enabled').checked;cfg.interval=Math.max(2,Math.min(60,Number($('#sfc-interval').value)||5));
  root.querySelectorAll('.sfc-card').forEach(card=>{const p=cfg.profiles.find(x=>x.id===card.dataset.id);if(!p)return;p.enabled=card.querySelector('.profile-enabled').checked;p.name=card.querySelector('.profile-name').value.trim()||'Fan';
    const pwm=findPwm(card.querySelector('.pwm-select').value);if(pwm)p.pwm={chip:pwm.chip,device:pwm.device,channel:pwm.channel};
    const rpm=findFan(card.querySelector('.rpm-select').value);p.rpm=rpm?{chip:rpm.chip,device:rpm.device,channel:rpm.channel}:null;
    p.sensor_mode=card.querySelector('.sensor-mode').value==='avg'?'avg':'max';p.sensors=[];card.querySelectorAll('.sensor-check:checked').forEach(ch=>{const s=findSensor(ch.value);if(!s)return;if(s.type==='nvidia')p.sensors.push({type:'nvidia',uuid:s.uuid,label:s.label});else if(s.type==='array_max')p.sensors.push({type:'array_max',label:s.label});else if(s.type==='hwmon')p.sensors.push({type:'hwmon',chip:s.chip,device:s.device,input:s.input,label:s.label});});
    p.min_pwm=Number(card.querySelector('.min-pwm').value)||0;p.critical_temp=Number(card.querySelector('.critical-temp').value)||80;p.failsafe_pwm=Number(card.querySelector('.failsafe-pwm').value)||100;p.min_rpm=Number(card.querySelector('.min-rpm').value)||0;p.rpm_guard_pwm=Number(card.querySelector('.rpm-guard-pwm').value)||35;
    p.curve=[...card.querySelectorAll('.sfc-curve tbody tr')].map(tr=>({temp:Number(tr.querySelector('.curve-temp').value),pwm:Number(tr.querySelector('.curve-pwm').value)})).filter(x=>Number.isFinite(x.temp)&&Number.isFinite(x.pwm)).sort((a,b)=>a.temp-b.temp);
  });
}
async function scan(show=true){try{syncFromDom();const d=await post('scan');hw=d.hardware||hw;if(d.config&&cfg.profiles.length===0)cfg=d.config;fanDisplay=d.fan_display||fanDisplay;renderFanDisplay(fanDisplay,true);render();if(show)msg(`扫描完成：${hw.pwms.length} 个 PWM，${hw.fans.length} 个 RPM，${allSensors().length} 个温度源。`);}catch(e){msg('扫描失败：'+e.message,false)}}
async function save(){try{syncFromDom();for(const p of cfg.profiles){if(p.enabled&&!p.pwm)throw new Error(`${p.name} 未选择 PWM 控制器`);if(p.enabled&&!p.sensors.length)throw new Error(`${p.name} 未选择温度传感器`);if(p.enabled&&p.curve.length<2)throw new Error(`${p.name} 至少需要 2 个曲线节点`);}const d=await post('save',{payload:JSON.stringify(cfg)});cfg=d.config||cfg;msg(cfg.enabled?'配置已保存，控制服务已重新启动。':'配置已保存，控制服务已停止并恢复 PWM 原控制模式。');await refreshStatus();}catch(e){msg('保存失败：'+e.message,false)}}
async function refreshStatus(){try{const d=await post('status');lastStatus=d.status||{};const running=!!d.running;$('#sfc-dot').className='sfc-dot '+(running?'run':'stop');$('#sfc-service-text').textContent=running?'服务运行中':'服务未运行';root.querySelectorAll('.sfc-card').forEach(card=>{const st=(lastStatus.profiles||{})[card.dataset.id];if(!st)return;card.querySelector('.live-temp').textContent=st.temperature==null?'--':st.temperature+' °C';card.querySelector('.live-pwm').textContent=st.applied_pwm==null?'--':st.applied_pwm+'%';card.querySelector('.live-rpm').textContent=st.rpm==null?'--':st.rpm+' RPM';card.querySelector('.live-state').textContent=st.reason||st.state||'--';});}catch(e){$('#sfc-dot').className='sfc-dot stop';$('#sfc-service-text').textContent='状态读取失败';}}
$('#sfc-driver-detect').addEventListener('click',detectDrivers);
$('#sfc-driver-save').addEventListener('click',saveDrivers);
$('#sfc-driver-refresh').addEventListener('click',()=>refreshDrivers(true));
$('#sfc-fan-display-save').addEventListener('click',saveFanDisplay);
$('#sfc-add').addEventListener('click',()=>{syncFromDom();cfg.profiles.push(defaultProfile());render();});
$('#sfc-scan').addEventListener('click',()=>scan(true));
$('#sfc-save').addEventListener('click',save);
async function init(){try{const d=await post('scan');hw=d.hardware||hw;cfg=d.config||cfg;driverInfo=d.drivers||driverInfo;fanDisplay=d.fan_display||fanDisplay;renderDriverInfo(driverInfo,true);renderFanDisplay(fanDisplay,true);render();await refreshStatus();}catch(e){renderFanDisplay(fanDisplay,true);render();msg('初始化失败：'+e.message,false);}pollTimer=setInterval(refreshStatus,5000);}
init();
})();
</script>

